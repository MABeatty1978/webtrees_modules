// One group, as a block of form fields.  The index only has to be different for each group.
$group_fields = static function (string $index, array $group): string {
    $e = static function (string $text): string {
        return e($text);
    };

    $id = 'group-' . $index;

    return
        '<div class="lh-group border rounded p-3 mb-3">' .
        '<input type="hidden" name="groups[' . $index . '][key]" value="' . $e($group['key']) . '">' .
        '<div class="row g-2">' .
        '<div class="col-md-4"><label class="form-label" for="' . $id . '-label">Name</label>' .
        '<input class="form-control" type="text" id="' . $id . '-label" name="groups[' . $index . '][label]" value="' . $e($group['label']) . '" maxlength="60" placeholder="e.g. Springfield"></div>' .
        '<div class="col-md-8"><label class="form-label" for="' . $id . '-places">Places <span class="text-muted">(one per line; not needed if shown to everyone)</span></label>' .
        '<textarea class="form-control font-monospace" id="' . $id . '-places" name="groups[' . $index . '][places]" rows="2" placeholder="Springfield&#10;Clark County, Ohio">' . $e($group['places']) . '</textarea></div>' .
        '<div class="col-md-8">' .
        '<div class="form-check form-check-inline">' .
        '<input class="form-check-input" type="radio" name="groups[' . $index . '][scope]" id="' . $id . '-connected" value="connected"' . ($group['scope'] !== 'everyone' ? ' checked' : '') . '>' .
        '<label class="form-check-label" for="' . $id . '-connected">Only people connected to one of its places</label>' .
        '</div>' .
        '<div class="form-check form-check-inline">' .
        '<input class="form-check-input" type="radio" name="groups[' . $index . '][scope]" id="' . $id . '-everyone" value="everyone"' . ($group['scope'] === 'everyone' ? ' checked' : '') . '>' .
        '<label class="form-check-label" for="' . $id . '-everyone">Everyone in the family tree</label>' .
        '</div>' .
        '</div>' .
        '<div class="col-md-4 d-flex align-items-center">' .
        '<div class="form-check"><input class="form-check-input" type="checkbox" id="' . $id . '-delete" name="groups[' . $index . '][delete]" value="1">' .
        '<label class="form-check-label" for="' . $id . '-delete">Delete this group</label></div>' .
        '</div>' .
        '</div>' .
        '</div>';
};

// One event, as a block of form fields.  $groups fills the "Group" dropdown.
$event_fields = static function (string $index, array $event) use ($groups): string {
    $e = static function (string $text): string {
        return e($text);
    };

    $id = 'event-' . $index;

    if ($groups === []) {
        $group_options = '<option value="">(add a group below first)</option>';
    } else {
        $group_options = '';

        foreach ($groups as $group) {
            $group_options .= '<option value="' . $e($group['key']) . '"' . ($event['group'] === $group['key'] ? ' selected' : '') . '>' . $e($group['label']) . '</option>';
        }
    }

    return
        '<div class="lh-event border rounded p-3 mb-3">' .
        '<div class="row g-2">' .
        '<div class="col-md-3"><label class="form-label" for="' . $id . '-date">Date</label>' .
        '<input class="form-control" type="text" id="' . $id . '-date" name="events[' . $index . '][date]" value="' . $e($event['date']) . '" maxlength="60" placeholder="e.g. 1850 or FROM 1861 TO 1865"></div>' .
        '<div class="col-md-5"><label class="form-label" for="' . $id . '-title">Title</label>' .
        '<input class="form-control" type="text" id="' . $id . '-title" name="events[' . $index . '][title]" value="' . $e($event['title']) . '" maxlength="100" placeholder="e.g. The railway arrives"></div>' .
        '<div class="col-md-4"><label class="form-label" for="' . $id . '-group">Group</label>' .
        '<select class="form-select" id="' . $id . '-group" name="events[' . $index . '][group]">' . $group_options . '</select></div>' .
        '<div class="col-md-8"><label class="form-label" for="' . $id . '-place">Place <span class="text-muted">(optional, shown with the event)</span></label>' .
        '<input class="form-control" type="text" id="' . $id . '-place" name="events[' . $index . '][place]" value="' . $e($event['place']) . '" maxlength="200"></div>' .
        '<div class="col-12"><label class="form-label" for="' . $id . '-text">Description <span class="text-muted">(optional)</span></label>' .
        '<textarea class="form-control" id="' . $id . '-text" name="events[' . $index . '][text]" rows="2" maxlength="500">' . $e($event['text']) . '</textarea></div>' .
        '<div class="col-md-8"><label class="form-label" for="' . $id . '-note">Private note <span class="text-muted">(never shown to visitors)</span></label>' .
        '<input class="form-control" type="text" id="' . $id . '-note" name="events[' . $index . '][note]" value="' . $e($event['note']) . '" maxlength="300" placeholder="e.g. check this date with the historical society"></div>' .
        '<div class="col-md-4 d-flex align-items-end gap-3">' .
        '<div class="form-check"><input class="form-check-input" type="checkbox" id="' . $id . '-enabled" name="events[' . $index . '][enabled]" value="1"' . ($event['enabled'] ? ' checked' : '') . '>' .
        '<label class="form-check-label" for="' . $id . '-enabled">Show</label></div>' .
        '<div class="form-check"><input class="form-check-input" type="checkbox" id="' . $id . '-delete" name="events[' . $index . '][delete]" value="1">' .
        '<label class="form-check-label" for="' . $id . '-delete">Delete</label></div>' .
        '</div>' .
        '</div>' .
        '</div>';
};

$blank_group = ['key' => '', 'label' => '', 'places' => '', 'scope' => 'connected'];
$blank_event = ['date' => '', 'title' => '', 'text' => '', 'place' => '', 'note' => '', 'group' => $groups[0]['key'] ?? '', 'enabled' => true];

?>

