/**
 * @var string                                                                       $action
 * @var array<array<string,mixed>>                                                   $events
 * @var array<string,array{name:string,description:string,events:int,places:int}>    $examples
 * @var string                                                                       $export
 * @var string                                                                       $import
 * @var int                                                                          $max_events
 * @var bool                                                                         $no_places
 * @var string                                                                       $script
 * @var array<string,string>                                                         $settings
 * @var string                                                                       $title
 */

// One event, as a group of form fields.  The index only has to be different for each event.
$event_fields = static function (string $index, array $event): string {
    $e = static function (string $text): string {
        return e($text);
    };

    $id = 'event-' . $index;

    return
        '<div class="lh-event border rounded p-3 mb-3">' .
        '<div class="row g-2">' .
        '<div class="col-md-3"><label class="form-label" for="' . $id . '-date">Date</label>' .
        '<input class="form-control" type="text" id="' . $id . '-date" name="events[' . $index . '][date]" value="' . $e($event['date']) . '" maxlength="60" placeholder="e.g. 1850 or FROM 1861 TO 1865"></div>' .
        '<div class="col-md-5"><label class="form-label" for="' . $id . '-title">Title</label>' .
        '<input class="form-control" type="text" id="' . $id . '-title" name="events[' . $index . '][title]" value="' . $e($event['title']) . '" maxlength="100" placeholder="e.g. The railway arrives"></div>' .
        '<div class="col-md-4"><label class="form-label" for="' . $id . '-place">Place <span class="text-muted">(optional)</span></label>' .
        '<input class="form-control" type="text" id="' . $id . '-place" name="events[' . $index . '][place]" value="' . $e($event['place']) . '" maxlength="200"></div>' .
        '<div class="col-12"><label class="form-label" for="' . $id . '-text">Description <span class="text-muted">(optional)</span></label>' .
        '<textarea class="form-control" id="' . $id . '-text" name="events[' . $index . '][text]" rows="2" maxlength="500">' . $e($event['text']) . '</textarea></div>' .
        '<div class="col-md-8"><label class="form-label" for="' . $id . '-note">Private note <span class="text-muted">(never shown to visitors)</span></label>' .
        '<input class="form-control" type="text" id="' . $id . '-note" name="events[' . $index . '][note]" value="' . $e($event['note']) . '" maxlength="300" placeholder="e.g. check this date with the historical society"></div>' .
        '<div class="col-md-4 d-flex align-items-end gap-3">' .
        '<div class="form-check"><input class="form-check-input" type="checkbox" id="' . $id . '-enabled" name="events[' . $index . '][enabled]" value="1"' . ($event['enabled'] ? ' checked' : '') . '>' .
        '<label class="form-check-label" for="' . $id . '-enabled">Show</label></div>' .
        '<div class="form-check"><input class="form-check-input" type="checkbox" id="' . $id . '-delete" name="events[' . $index . '][delete]" value="1">' .
        '<label class="form-check-label" for="' . $id . '-delete">Delete</label></div>' .
        '</div>' .
        '</div>' .
        '</div>';
};

$blank = ['date' => '', 'title' => '', 'text' => '', 'place' => '', 'note' => '', 'enabled' => true];

?>

